#!/usr/bin/env bash
#
# A rebuild script that commits on a successful build across local and remote hosts
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pushd "$SCRIPT_DIR" > /dev/null

if [[ "$1" =~ ^(-h|--help)$ ]]; then
  echo "Usage: ./apply [boot|reboot|switch|test] [<host[:ip]> ...]"
  echo ""
  echo "Actions:"
  echo "  boot (default)  Build and set as default boot configuration"
  echo "  reboot          Build, set as default boot configuration, and reboot"
  echo "  switch          Build and switch to new configuration immediately"
  echo "  test            Build and activate configuration without adding to bootloader"
  echo ""
  echo "Targets:"
  echo "  <host>          Hostname defined in flake (e.g. cloudburst-laptop)"
  echo "  <host>:<ip>     Hostname defined in flake with explicit target IP/address (e.g. brix0:192.168.1.50)"
  echo "  (default)       Localhost ($(hostname))"
  exit 0
fi

# Firstly generate flake.nix from flake-file.nix
if [[ -x "./flake" ]]; then
  ./flake
fi

nix flake lock

# Autoformat nix files gracefully
if ! alejandra . &>/dev/null; then
  alejandra .
  echo "❌ Formatting failed!"
  exit 1
fi
git add .

# Parse action (1st arg)
ACTION="boot"
DO_REBOOT=false
DISPLAY_ACTION="boot"
if [[ "$1" =~ ^(boot|b|reboot|r|switch|s|test|t)$ ]]; then
  case "$1" in
    b|boot)   ACTION="boot"; DISPLAY_ACTION="boot" ;;
    r|reboot) ACTION="boot"; DISPLAY_ACTION="reboot"; DO_REBOOT=true ;;
    s|switch) ACTION="switch"; DISPLAY_ACTION="switch" ;;
    t|test)   ACTION="test"; DISPLAY_ACTION="test" ;;
  esac
  shift
fi

LOCAL_HOST=$(hostname)

# Parse target hosts (remaining args, default to localhost)
TARGETS=("${@:-$LOCAL_HOST}")

# --- Get password once for all devices ---
echo -n "[sudo] Password for all hosts: "
read -rs PASSWORD
echo ""

COMMIT_ENTRIES=()
REBOOT_LOCAL=false

for TARGET in "${TARGETS[@]}"; do
  HOST="$TARGET"
  DEST="$TARGET"

  if [[ "$TARGET" == *:* ]]; then
    HOST="${TARGET%%:*}"
    DEST="${TARGET#*:}"
    [[ -z "$DEST" ]] && DEST="$HOST"
  fi

  USER_PREFIX=""
  if [[ "$HOST" == *@* ]]; then
    USER_PREFIX="${HOST%%@*}@"
    HOST="${HOST#*@}"
    if [[ "$DEST" != *@* ]]; then
      DEST="${USER_PREFIX}${DEST}"
    fi
  fi

  [[ "$HOST" == "localhost" || "$HOST" == "127.0.0.1" ]] && HOST="$LOCAL_HOST"
  [[ "$DEST" == "localhost" || "$DEST" == "127.0.0.1" ]] && DEST="$LOCAL_HOST"

  if [[ "$HOST" != "$DEST" ]]; then
    echo -e "\n🚀 NixOS Rebuilding host '$HOST' via '$DEST' with action '$DISPLAY_ACTION'..."
  else
    echo -e "\n🚀 NixOS Rebuilding host '$HOST' with action '$DISPLAY_ACTION'..."
  fi

  if [[ "$HOST" == "$LOCAL_HOST" && "$DEST" == "$LOCAL_HOST" ]]; then
    echo "$PASSWORD" | sudo -S -v &>/dev/null

    if ! echo "$PASSWORD" | sudo -S nixos-rebuild "$ACTION" --flake ".#$HOST" 2>&1 | tee nixos-switch.log | nom; then
      echo -e "\n❌ Local rebuild failed on $HOST!"
      grep --color -E -i "error|trace|failed" nixos-switch.log || tail -n 20 nixos-switch.log
      exit 1
    fi
    GEN=$(nixos-rebuild list-generations --json | jq -r '.[] | select (.current == true) | .generation')
    if [[ "$DO_REBOOT" == true ]]; then
      REBOOT_LOCAL=true
    fi
  else
    export NIX_SSHOPTS="-o StrictHostKeyChecking=accept-new"

    echo "   📦 Building system closure locally..."
    if ! nixos-rebuild build --flake ".#$HOST" 2>&1 | tee nixos-switch.log | nom; then
      echo -e "\n❌ Local build for remote host $HOST failed!"
      grep --color -E -i "error|trace|failed" nixos-switch.log || tail -n 20 nixos-switch.log
      exit 1
    fi

    SYSTEM_PATH=$(readlink -f ./result)

    echo "   🚚 Pushing closure to $DEST..."
    if ! nix-copy-closure --to "$DEST" "$SYSTEM_PATH" 2>&1 | nom; then
      echo -e "\n❌ Failed to push closure to $DEST!"
      exit 1
    fi

    echo "   🔗 Registering new system profile..."
    if ! echo "$PASSWORD" | ssh $NIX_SSHOPTS "$DEST" "sudo -S nix-env -p /nix/var/nix/profiles/system --set $SYSTEM_PATH"; then
       echo -e "\n❌ Failed to set system profile on $DEST!"
       exit 1
    fi

    echo "   ⚡ Activating configuration ($ACTION)..."
    if ! echo "$PASSWORD" | ssh $NIX_SSHOPTS "$DEST" "sudo -S $SYSTEM_PATH/bin/switch-to-configuration $ACTION"; then
       echo -e "\n❌ Remote activation failed on $DEST!"
       exit 1
    fi

    GEN=$(echo "$PASSWORD" | ssh $NIX_SSHOPTS "$DEST" "sudo -S nixos-rebuild list-generations --json 2>/dev/null" | jq -r '.[] | select (.current == true) | .generation')
    [[ -z "$GEN" || "$GEN" == "null" ]] && GEN="unknown"

    if [[ "$DO_REBOOT" == true ]]; then
      if [[ "$HOST" != "$DEST" ]]; then
        echo "   🔄 Rebooting remote host '$HOST' ($DEST)..."
      else
        echo "   🔄 Rebooting remote host '$HOST'..."
      fi
      echo "$PASSWORD" | ssh $NIX_SSHOPTS "$DEST" "sudo -S reboot" &>/dev/null || true
    fi
  fi

  COMMIT_ENTRIES+=("${HOST}:${GEN}")
done

COMMIT_MSG="${COMMIT_ENTRIES[*]}"

if git diff --quiet && git diff --staged --quiet; then
  echo -e "\n✅ No git changes to commit."
else
  git commit -m "$COMMIT_MSG"
  echo -e "\n✅ Committed: $COMMIT_MSG"
fi

popd > /dev/null

notify-send -e "NixOS Rebuilt OK!" "${COMMIT_ENTRIES[*]}" --icon=system-software-update || true

if [[ "$REBOOT_LOCAL" == true ]]; then
  echo -e "\n🔄 Rebooting local host '$LOCAL_HOST'..."
  echo "$PASSWORD" | sudo -S reboot
fi
