#!/usr/bin/env bash
#
# Generates features-full.nix by evaluating the default state of all modules
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pushd "$SCRIPT_DIR" > /dev/null

NIX_EXPR='
let
  flake = builtins.getFlake (toString ./.);
  inherit (flake.inputs.nixpkgs) lib;
  options = flake.nixosConfigurations.cloudburst-desktop.options.features;

  isOption = v: builtins.isAttrs v && (v ? _type && v._type == "option" || v ? type && v ? default);

  extractDefaults = v:
    if isOption v then
      if v ? default then v.default else null
    else if builtins.isAttrs v then
      let
        sub = lib.filterAttrs (k: val: val != null) (
          builtins.mapAttrs (_: extractDefaults) (builtins.removeAttrs v ["_module"])
        );
      in
        if sub == {} then null else sub
    else null;

  indent = n: lib.concatStrings (lib.genList (_: "  ") n);

  formatValue = lvl: v:
    if builtins.isBool v then (if v then "true" else "false")
    else if builtins.isString v then
      if lib.hasPrefix "/nix/store" v && lib.hasInfix "driftwm" v then
        "\"" + "\${pkgs.driftwm}/bin/driftwm\""
      else
        builtins.toJSON v
    else if builtins.isInt v then toString v
    else if builtins.isNull v then "null"
    else if builtins.isList v then
      if v == [] then "[]"
      else if lib.all (x: builtins.isString x && lib.stringLength x > 15) v then
        "[\n" + (lib.concatMapStringsSep "\n" (x: "${indent (lvl + 1)}${builtins.toJSON x}") v) + "\n${indent lvl}]"
      else
        "[ " + (lib.concatMapStringsSep " " (formatValue lvl) v) + " ]"
    else if builtins.isAttrs v then
      if v == {} then "{}"
      else "{\n" + (formatTree (lvl + 1) v) + "\n${indent lvl}}"
    else "null";

  formatTree = lvl: attrs:
    let
      names = builtins.attrNames attrs;
      lines = map (name:
        let
          val = attrs.${name};
        in
          if builtins.isAttrs val && val != {} && !(isOption val) then
            "${indent lvl}${name} = {\n" + (formatTree (lvl + 1) val) + "\n${indent lvl}};"
          else
            "${indent lvl}${name} = ${formatValue lvl val};"
      ) names;
    in
      lib.concatStringsSep "\n" lines;

  defaults = extractDefaults options;
in
  "{\n  features = {\n" + (formatTree 2 defaults) + "\n  };\n}\n"
'

echo "Evaluating default features from modules..."
nix eval --impure --raw --expr "$NIX_EXPR" > features-full.nix

if command -v alejandra &>/dev/null; then
  alejandra features-full.nix &>/dev/null || true
fi

echo "✅ Generated features-full.nix successfully."
popd > /dev/null
