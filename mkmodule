#!/usr/bin/env python3
import sys
import os
import re
import shutil
import subprocess
import json


def normalize_path(raw_input):
    s = raw_input.strip()
    if s.startswith("modules/"):
        s = s[len("modules/") :]
        if s.endswith("/default.nix"):
            s = s[: -len("/default.nix")]
        elif s.endswith(".nix"):
            s = s[: -len(".nix")]
        return s.replace("/", ".")

    for prefix in ["config.features.", "features."]:
        if s.startswith(prefix):
            s = s[len(prefix) :]
            break
    return s


def find_canonical_default(feature_path, repo_root):
    features_full = os.path.join(repo_root, "features-full.nix")
    if not os.path.exists(features_full):
        return None

    parts = feature_path.split(".")
    nix_path = " ".join(f'"{p}"' for p in parts)
    expr = f"""
    let
      full = import {os.path.abspath(features_full)};
      getIn = attrs: path:
        builtins.foldl' (acc: elem: if acc != null && builtins.isAttrs acc && acc ? ${{elem}} then acc.${{elem}} else null) attrs path;
      val = getIn full.features [ {nix_path} ];
    in
      if val == null then null
      else if builtins.isBool val then val
      else if builtins.isAttrs val && val ? enable then val.enable
      else null
    """
    res = subprocess.run(
        ["nix", "eval", "--impure", "--json", "--expr", expr],
        cwd=repo_root,
        capture_output=True,
        text=True,
    )
    if res.returncode == 0:
        try:
            return json.loads(res.stdout)
        except Exception:
            return None
    return None


def move_file(src, dst, repo_root):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    res = subprocess.run(
        ["git", "mv", src, dst],
        cwd=repo_root,
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        shutil.move(src, dst)
    print(f"Moved {os.path.relpath(src, repo_root)} -> {os.path.relpath(dst, repo_root)}", file=sys.stderr)


def ensure_ancestor_directories(feature_path, repo_root, force_dir=False):
    parts = feature_path.split(".")
    # Check all intermediate ancestor paths
    check_limit = len(parts) if force_dir else len(parts) - 1
    for i in range(1, check_limit + 1):
        prefix_parts = parts[:i]
        prefix_feature_path = "features." + ".".join(prefix_parts)
        if len(prefix_parts) > 1:
            prefix_file = os.path.join(repo_root, "modules", *prefix_parts[:-1], f"{prefix_parts[-1]}.nix")
        else:
            prefix_file = os.path.join(repo_root, "modules", f"{prefix_parts[0]}.nix")

        prefix_dir = os.path.join(repo_root, "modules", *prefix_parts)
        target_default = os.path.join(prefix_dir, "default.nix")

        if os.path.isfile(prefix_file):
            move_file(prefix_file, target_default, repo_root)

            # If the file had a bare option definition, update it to use .enable
            with open(target_default, "r", encoding="utf-8") as f:
                orig_content = f.read()

            bare_pattern = rf"options\.{re.escape(prefix_feature_path)}\s*=\s*lib\.mkOption\s*\{{"
            if re.search(bare_pattern, orig_content):
                new_content = re.sub(
                    bare_pattern,
                    f"options.{prefix_feature_path}.enable = lib.mkOption {{",
                    orig_content,
                )
                new_content = re.sub(
                    r"lib\.mkIf\s+cfg\s*\{",
                    "lib.mkIf cfg.enable {",
                    new_content,
                )
                with open(target_default, "w", encoding="utf-8") as f:
                    f.write(new_content)
                print(f"Updated {os.path.relpath(target_default, repo_root)} to use .enable", file=sys.stderr)


def resolve_target_file(feature_path, repo_root, force_dir=False):
    parts = feature_path.split(".")
    if len(parts) == 1:
        return os.path.join("modules", parts[0], "default.nix")

    dir_path = os.path.join(repo_root, "modules", *parts)
    if force_dir or os.path.isdir(dir_path):
        return os.path.join("modules", *parts, "default.nix")

    file_path = os.path.join("modules", *parts[:-1], f"{parts[-1]}.nix")
    default_path = os.path.join("modules", *parts, "default.nix")

    if os.path.isfile(os.path.join(repo_root, default_path)):
        return default_path
    if os.path.isfile(os.path.join(repo_root, file_path)):
        return file_path

    return file_path


def generate_boilerplate(feature_path, repo_root):
    parts = feature_path.split(".")
    full_path = "features." + ".".join(parts)
    canonical = find_canonical_default(feature_path, repo_root)

    if len(parts) > 1:
        parent_path = "features." + ".".join(parts[:-1])
        canonical_val = "false" if canonical is False else "true"
        default_expr = f"config.{parent_path}.enable && {canonical_val}"
    else:
        default_expr = "false" if canonical is False else "true"

    code = f"""{{
  config,
  lib,
  pkgs,
  inputs,
  ...
}}: let
  cfg = config.{full_path};
in {{
  options.{full_path} = {{
    enable = lib.mkOption {{
      type = lib.types.bool;
      default = {default_expr};
    }};
  }};

  config = lib.mkMerge [
    {{
      flake-file.inputs = {{}};
    }}
    (lib.mkIf cfg.enable {{
    }})
  ];
}}
"""
    return code


def main():
    if len(sys.argv) < 2:
        print("Usage: ./mkmodule [--dir] <feature-path>", file=sys.stderr)
        print("Example: ./mkmodule features.gui.apps.brave", file=sys.stderr)
        sys.exit(1)

    args = sys.argv[1:]
    force_dir = False
    if "--dir" in args or "-d" in args:
        force_dir = True
        args = [a for a in args if a not in ("--dir", "-d")]

    if not args:
        print("Error: No feature path specified.", file=sys.stderr)
        sys.exit(1)

    raw_path = args[0]
    repo_root = os.path.dirname(os.path.abspath(__file__))
    feature_path = normalize_path(raw_path)

    ensure_ancestor_directories(feature_path, repo_root, force_dir=force_dir)

    target_rel = resolve_target_file(feature_path, repo_root, force_dir=force_dir)
    target_abs = os.path.join(repo_root, target_rel)

    os.makedirs(os.path.dirname(target_abs), exist_ok=True)

    if not os.path.exists(target_abs):
        content = generate_boilerplate(feature_path, repo_root)
        with open(target_abs, "w", encoding="utf-8") as f:
            f.write(content)

    print(target_rel)


if __name__ == "__main__":
    main()
