#!/usr/bin/env bash
#
# A script to validate NixOS configuration changes (dry-run) without applying them.
# Displays a condensed output focusing only on errors if the build fails.
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pushd "$SCRIPT_DIR" >/dev/null

# Firstly generate flake.nix from flake-file.nix
if [[ -x "./flake" ]]; then
  ./flake
fi

alejandra . &>/dev/null \
  || ( alejandra . ; echo "formatting failed!" && exit 1)

git add -N .

echo "Validating NixOS configuration (dry-run)..."

LOGFILE=$(mktemp)
trap 'rm -f "$LOGFILE"' EXIT

TARGET="${1:-$(hostname)}"

if ! nixos-rebuild build --flake ".#$TARGET" --no-link > "$LOGFILE" 2>&1; then
    echo -e "\n❌ Configuration validation failed! Errors:\n"
    if grep -E -i "error|trace|failed" "$LOGFILE"; then
        true
    else
        tail -n 20 "$LOGFILE"
    fi
    popd >/dev/null
    exit 1
fi

echo "✅ Configuration is valid! Dry-run succeeded for $TARGET."
popd >/dev/null
