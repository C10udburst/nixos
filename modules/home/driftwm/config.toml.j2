mod_key = "super"
autostart = [
{% for cmd in extracmds %}
  "{{ cmd }}",
{% endfor %}
{% if touchscreen %}
  "auto-rotate",
{% endif %}
  "while true; do noctalia; sleep 1; done"
]
window_placement = "auto"

[env]
"_JAVA_AWT_WM_NONREPARENTING" = "1"
"QT_QPA_PLATFORM" = "wayland;xcb"

[input.keyboard]
layout = "pl"
num_lock = true

[input.mouse]
accel_speed = 0.1
accel_profile = "adaptive"

[input.trackpad]
accel_speed = 0.1
click_method = "button_areas"

[cursor]
inactive_opacity = 0.25

[mouse.on-canvas]
"right" = "spawn noctalia msg panel-toggle launcher"

[mouse.anywhere]
"ctrl+alt+trackpad-scroll" = "pan-viewport"
"ctrl+alt+left" = "pan-viewport"

[touch.on-canvas]
"2-finger-tap" = "spawn noctalia msg panel-toggle launcher"

[touch.anywhere]
"4-finger-tap" = "spawn noctalia msg panel-toggle launcher"

[gestures]
swipe_threshold = 6

[gestures.on-window]
"3-finger-doubletap-swipe" = "none"
"alt+3-finger-doubletap-swipe" = "move-window"
"ctrl+alt+3-finger-doubletap-swipe" = "resize-window"
"ctrl+2-finger-pinch-in" = "zoom-out"
"ctrl+2-finger-pinch-out" = "zoom-in"

[navigation.edge_pan]
zone = 60.0
cursor_zone = 10.0
speed_min = 1.0
speed_max = 6.0
cursor_pan = false

[snap]
enabled = true
gap = 8
distance = 20
centers = true
corners = true

[zoom]
trackpad_speed = 1.2
reset_on_new_window = false
reset_on_activation = false
fit_padding = 24.0

[background]
type = "shader"
path = "~/.config/driftwm/background.glsl"
animate_fps = {% if slow %}15{% else %}24{% endif %}

{% if slow %}
[effects]
blur_radius = 0
{% endif %}

[decorations]
title_bar_height = 30
bg_color = "#{{ base00 }}"
fg_color = "#{{ base05 }}"
corner_radius = 10
border_width = 2
border_color = "#{{ base02 }}"
border_color_focused = "#{{ base0E }}"
shadow = true
font = "{{ font }}"

[output.outline]
color = "#{{ base0E }}"
thickness = 1

[xwayland]
enabled = true
path = "{{ xwayland_satellite_path }}"

[keybindings]
"mod+tab" = 'spawn noctalia msg panel-toggle launcher "/win "'
"mod+space" = 'spawn noctalia msg panel-toggle launcher'
"mod+return" = 'spawn noctalia msg panel-toggle launcher'
"mod+n" = 'spawn noctalia msg notifications toggleHistory'
"mod+v" = 'spawn noctalia msg panel-toggle clipboard'
"mod+period" = 'spawn noctalia msg panel-toggle launcher "/emo "'
"mod+escape" = 'spawn noctalia msg panel-toggle session'
"mod+f11" = 'spawn noctalia msg bar-toggle main'
"mod+l" = 'spawn noctalia msg session lock'
"mod+r" = 'spawn noctalia msg panel-toggle control-center'

"ctrl+alt+t" = "exec konsole"
"ctrl+shift+escape" = "exec plasma-systemmonitor"
"XF86Calculator" = "exec qalculate-qt"
"XF86Search" = "exec brave"
"XF86WWW" = "exec brave"
"XF86Mail" = "exec brave https://mail.google.com"

"XF86AudioRaiseVolume" = "spawn pamixer -i 5"
"XF86AudioLowerVolume" = "spawn pamixer -d 5"
"XF86MonBrightnessUp" = "spawn noctalia msg brightness increase"
"XF86MonBrightnessDown" = "spawn noctalia msg brightness decrease"
"XF86AudioMute" = "spawn pamixer -t"

"alt+f4" = "close-window"
"mod+equal" = "zoom-in"
"mod+minus" = "zoom-out"
"mod+up" = "center-nearest up"
"mod+down" = "center-nearest down"
"mod+left" = "center-nearest left"
"mod+right" = "center-nearest right"
"mod+q" = "close-window"
"mod+e" = "exec dolphin"
"mod+w" = "pan-viewport up"
"mod+s" = "pan-viewport down"
"mod+a" = "pan-viewport left"
"mod+d" = "pan-viewport right"

{{ extra_bindings }}

# Cosmic settings: hide winit window helper and apply fixed window size
[[window_rules]]
title = "winit window"
widget = true

[[window_rules]]
app_id = "Waydroid"
decoration = "server"

[[window_rules]]
app_id = "waydroid.*"
decoration = "server"

{% if touchscreen %}
[[window_rules]]
app_id = "wvkbd"
pinned_to_screen = true
{% endif %}

[input.touch]
enable = true

{{ extra_config }}
