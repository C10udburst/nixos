{
  config,
  lib,
  helpers,
  ...
}: let
  piCfg = config.features.shell.utils.llm.pi;
  # The gateway URLs and the extension groups that go with them: a prompt may
  # only mention a tool the agent's extension group actually loads.
  ext = piCfg.extensions;

  # pi reads `<agent dir>/SYSTEM.md` and uses it in place of its own prompt: the
  # preamble becomes this text, and the `<docs>` section pi would otherwise add
  # (pi's own documentation tree, extension examples, the TUI guide) is not built
  # at all. The `<tools>`, `<rules>`, `<project_context>` and `<cwd>` sections
  # are still generated by pi from the tools and files really in play, which is
  # why these templates describe the machine and never list tools.
  templates = {
    pi = ./_pi.md.j2;
    organizeer = ./_organizeer.md.j2;
  };

  # One SYSTEM.md per pi-family agent. `template` picks the voice, the flags pick
  # the sections, and every flag defaults to what the full pi agent really has:
  # the search tool only when the gateway is configured, comma only when the core
  # package set is installed. Agents whose group differs say so.
  mkSystemPrompt =
    {
      name ? "pi",
      template ? "pi",
      google ? (ext.googleUrl != null),
      comma ? config.features.shell.utils.core,
      nix ? true,
    }:
    helpers.render "${name}-SYSTEM.md" templates.${template} {
      inherit google comma nix;
    };
in {
  options.features.shell.utils.llm.pi.prompt = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = piCfg.enable && true;
    };

    # The function every consumer calls for the SYSTEM.md of its own agent
    # directory: pi and pi-web take the defaults, the organizer pi its template.
    shared.mkSystemPrompt = lib.mkOption {
      type = lib.types.functionTo lib.types.pathInStore;
      internal = true;
    };
  };

  config.features.shell.utils.llm.pi.prompt.shared.mkSystemPrompt = mkSystemPrompt;
}
