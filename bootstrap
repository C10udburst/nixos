#!/usr/bin/env bash
#
# A script to bootstrap a new host configuration from the template
set -e

print_usage() {
  echo "Usage: ./bootstrap <new-hostname>"
  echo "Example: ./bootstrap my-new-server"
}

if [ -z "$1" ]; then
  print_usage
  exit 1
fi

HOSTNAME="$(echo "$1" | xargs)"
if [ -z "$HOSTNAME" ]; then
  echo "Error: hostname cannot be empty."
  print_usage
  exit 1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOOTSTRAP_DIR="$REPO_ROOT/hosts/bootstrap"
TARGET_DIR="$REPO_ROOT/hosts/$HOSTNAME"

if [ ! -d "$BOOTSTRAP_DIR" ]; then
  echo "Error: Bootstrap template directory not found at $BOOTSTRAP_DIR"
  exit 1
fi

if [ -e "$TARGET_DIR" ]; then
  echo "Error: Host directory already exists at $TARGET_DIR"
  exit 1
fi

echo "Bootstrapping configuration for new host: '$HOSTNAME'..."

# 1. Copy bootstrap template to target directory
if cp -r "$BOOTSTRAP_DIR" "$TARGET_DIR"; then
  echo "✓ Copied template to $TARGET_DIR"
else
  echo "Error copying template directory."
  exit 1
fi

# 2. Update hostname in configuration.nix
CONFIG_PATH="$TARGET_DIR/configuration.nix"
if [ -f "$CONFIG_PATH" ]; then
  sed -i "s/\"bootstrap-host\"/\"$HOSTNAME\"/g" "$CONFIG_PATH"
  echo "✓ Set hostname to '$HOSTNAME' in configuration.nix"
else
  echo "Warning: configuration.nix not found at $CONFIG_PATH"
fi

# 3. Copy hardware-configuration.nix from /etc/nixos/ if it exists
ETC_HW_PATH="/etc/nixos/hardware-configuration.nix"
TARGET_HW_PATH="$TARGET_DIR/hardware-configuration.nix"
if [ -f "$ETC_HW_PATH" ]; then
  if cp "$ETC_HW_PATH" "$TARGET_HW_PATH" 2>/dev/null; then
    echo "✓ Copied hardware configuration from $ETC_HW_PATH"
  else
    echo "Warning: Could not copy $ETC_HW_PATH. Retaining template fallback."
  fi
else
  echo "Warning: $ETC_HW_PATH not found. Retaining template fallback hardware-configuration.nix."
fi

# 4. Modify outputs.nix to register the new host
OUTPUTS_PATH="$REPO_ROOT/outputs.nix"
if [ -f "$OUTPUTS_PATH" ]; then
  sed -i "/nixosConfigurations = {/a \    $HOSTNAME = mkHost { hostName = \"$HOSTNAME\"; };" "$OUTPUTS_PATH"
  echo "✓ Registered '$HOSTNAME' in outputs.nix under nixosConfigurations"
else
  echo "Error: outputs.nix not found at $OUTPUTS_PATH"
  exit 1
fi

# 5. Format Nix files
echo "Formatting repository with alejandra..."
if (cd "$REPO_ROOT" && alejandra . &>/dev/null); then
  echo "✓ Formatting completed successfully."
else
  echo "Warning: Failed to run alejandra formatting."
fi

# 6. Stage files in Git
echo "Staging files in Git..."
if (cd "$REPO_ROOT" && git add "hosts/$HOSTNAME" "outputs.nix"); then
  echo "✓ Staged host configuration directory and outputs.nix."
else
  echo "Warning: Failed to run git add."
fi

echo ""
echo "🎉 Successfully bootstrapped host '$HOSTNAME'!"
echo "Configuration is located at: hosts/$HOSTNAME/"
echo "You can dry-run build this config with: nixos-rebuild build --flake .#$HOSTNAME --no-link"
