#!/usr/bin/env bash
#
# Generates flake.nix from flake-file.nix and dendritic modules
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pushd "$SCRIPT_DIR" > /dev/null

echo "❄️  Generating flake.nix from flake-file.nix..."

GEN_EXPR='
let
  flake = builtins.getFlake (toString ./.);
  ffPath = flake.inputs.flake-file.outPath;
  pkgs = flake.inputs.nixpkgs.legacyPackages.x86_64-linux;
  lib = pkgs.lib;
  importTree = import ./lib/import-tree.nix;
  files = (importTree.pipeTo (f: f)) ./modules;

  findInputsInAttrs = a:
    if builtins.isAttrs a then
      if a ? flake-file && a.flake-file ? inputs then a.flake-file.inputs
      else if a ? _type && a._type == "merge" && a ? contents then
        lib.foldl (acc: item: acc // (findInputsInAttrs item)) {} a.contents
      else if a ? config then findInputsInAttrs a.config
      else {}
    else {};

  extract = file:
    let
      content = builtins.readFile file;
      hasInputs = builtins.match ".*flake-file\\.inputs.*" content != null;
    in
      if !hasInputs then {}
      else
        let
          fn = import file;
          dummyArgs = {
            config = {};
            inherit lib;
            pkgs = {
              stdenv.hostPlatform.system = "x86_64-linux";
              system = "x86_64-linux";
            };
            inputs = {};
          };
          res = if builtins.isFunction fn then fn dummyArgs else fn;
        in
          findInputsInAttrs res;

  moduleInputs = lib.foldl (acc: item: acc // item) {} (map extract files);

  res = import ffPath {
    inherit pkgs;
    modules = [
      ./flake-file.nix
      {
        flake-file.inputs = moduleInputs;
      }
    ];
  };
in
  res.flake-file.apps.write-flake pkgs
'

WRITE_FLAKE=$(nix build --impure --no-link --print-out-paths --expr "$GEN_EXPR")
"$WRITE_FLAKE/bin/write-flake"

if command -v alejandra &>/dev/null; then
  alejandra flake.nix &>/dev/null || true
fi

echo "✅ flake.nix regenerated successfully."
popd > /dev/null
