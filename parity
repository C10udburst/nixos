#!/usr/bin/env python3
"""Evaluate each NixOS host on legacy and dendritic configurations, outputting differences in raw JSON."""

import argparse
import json
import os
import subprocess
import sys

NIX_EXPR = """
let
  oldFlake = builtins.getFlake "{old_path}";
  newFlake = builtins.getFlake "{new_path}";
  lib = newFlake.inputs.nixpkgs.lib;

  getPkgName = p:
    if p == null then null
    else if p ? name then p.name
    else if p ? pname && p ? version then "${p.pname}-${p.version}"
    else if p ? pname then p.pname
    else toString p;

  extractPkgs = cfg: {
    systemPackages = lib.unique (builtins.sort (a: b: a < b) (
      builtins.filter (x: x != null) (
        map getPkgName (cfg.config.environment.systemPackages or [])
      )
    ));
    homePackages = lib.unique (builtins.sort (a: b: a < b) (
      builtins.filter (x: x != null) (
        map getPkgName (cfg.config.home-manager.users.cloudburst.home.packages or [])
      )
    ));
  };

  oldBootstrap = oldFlake.inputs.nixpkgs.lib.nixosSystem {
    system = "x86_64-linux";
    modules = [
      {old_path}/hosts/bootstrap/configuration.nix
      oldFlake.inputs.home-manager.nixosModules.home-manager
      oldFlake.inputs.stylix.nixosModules.stylix
      {
        home-manager.useGlobalPkgs = true;
        home-manager.useUserPackages = true;
        home-manager.users.cloudburst = {
          imports = [oldFlake.inputs.plasma-manager.homeModules.plasma-manager];
        };
      }
    ];
    specialArgs = { inherit (oldFlake) inputs; };
  };

  oldHosts = {
    cloudburst-desktop = oldFlake.nixosConfigurations.cloudburst-desktop;
    cloudburst-laptop = oldFlake.nixosConfigurations.cloudburst-laptop;
    cloudburst-tablet = oldFlake.nixosConfigurations.cloudburst-tablet;
    bootstrap = oldBootstrap;
  };

  newHosts = {
    cloudburst-desktop = newFlake.nixosConfigurations.cloudburst-desktop;
    cloudburst-laptop = newFlake.nixosConfigurations.cloudburst-laptop;
    cloudburst-tablet = newFlake.nixosConfigurations.cloudburst-tablet;
    bootstrap = newFlake.nixosConfigurations.bootstrap;
  };

  diffLists = old: new: {
    added = builtins.filter (x: !(builtins.elem x old)) new;
    removed = builtins.filter (x: !(builtins.elem x new)) old;
  };

  diffHost = host:
    let
      oldData = extractPkgs oldHosts.${host};
      newData = extractPkgs newHosts.${host};
    in {
      systemPackages = diffLists oldData.systemPackages newData.systemPackages;
      homePackages = diffLists oldData.homePackages newData.homePackages;
    };
in {
  cloudburst-desktop = diffHost "cloudburst-desktop";
  cloudburst-laptop = diffHost "cloudburst-laptop";
  cloudburst-tablet = diffHost "cloudburst-tablet";
  bootstrap = diffHost "bootstrap";
}
"""


def main():
    default_new = os.path.dirname(os.path.abspath(__file__))
    default_old = "/home/cloudburst/nixos"

    parser = argparse.ArgumentParser(
        description="Evaluate each NixOS host on legacy and dendritic data and output differences in JSON."
    )
    parser.add_argument(
        "--old",
        default=default_old,
        help=f"Path to legacy NixOS flake (default: {default_old})",
    )
    parser.add_argument(
        "--new",
        default=default_new,
        help=f"Path to new dendritic NixOS flake (default: {default_new})",
    )
    parser.add_argument(
        "--host",
        default=None,
        help="Optional single host filter (e.g. cloudburst-desktop)",
    )
    args = parser.parse_args()

    expr = NIX_EXPR.replace("{old_path}", os.path.abspath(args.old)).replace(
        "{new_path}", os.path.abspath(args.new)
    )
    cmd = ["nix", "eval", "--impure", "--json", "--expr", expr]

    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        sys.stderr.write(f"Error evaluating parity: {proc.stderr}\n")
        sys.exit(proc.returncode)

    data = json.loads(proc.stdout)
    if args.host:
        if args.host not in data:
            sys.stderr.write(
                f"Unknown host '{args.host}'. Available hosts: {list(data.keys())}\n"
            )
            sys.exit(1)
        data = {args.host: data[args.host]}

    print(json.dumps(data, indent=2))


if __name__ == "__main__":
    main()
